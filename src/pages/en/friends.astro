---
import SiteLayout from '../../layouts/SiteLayout.astro';
---
<SiteLayout lang="en" title="Links" description="Friends and favorite websites of Pangpang Blog.">
	<main class="reading-container text-page">
		<span class="eyebrow">Links</span>
		<h1>Links</h1>
		<p>A place for websites I often read, blogs I like, and friends' corners of the internet. I can add more once I choose the first few.</p>
		<div class="friend-list">
			<a class="friend-card" href="https://astro.build/" target="_blank" rel="noopener noreferrer"><strong>Astro ↗</strong><p>The framework used to build this blog.</p></a>
			<a class="friend-card" href="https://docs.astro.build/" target="_blank" rel="noopener noreferrer"><strong>Astro Docs ↗</strong><p>A reference for creating pages and maintaining the site.</p></a>
		</div>
		<p class="note">Edit this page in src/pages/en/friends.astro. The links above are examples.</p>
	</main>
</SiteLayout>
