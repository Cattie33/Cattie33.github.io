---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { localeFromPath, type Locale } from '../i18n';

interface Props { title?: string; description?: string; lang?: Locale; }
const lang = Astro.props.lang ?? localeFromPath(Astro.url.pathname);
const title = Astro.props.title ?? SITE_TITLE;
const description = Astro.props.description ?? (lang === 'en' ? "Mi's stories and writing." : SITE_DESCRIPTION);
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
	<head><BaseHead title={title} description={description} lang={lang} /></head>
	<body>
		<Header lang={lang} />
		<slot />
		<Footer lang={lang} />
	</body>
</html>
