---
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;
const links = [
	{ href: '/', label: '首页' },
	{ href: '/blog/', label: '文章' },
	{ href: '/about/', label: '关于' },
	{ href: '/friends/', label: '友链' },
];
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} 首页`}><span class="brand-mark">胖</span><span>{SITE_TITLE}</span></a>
		<nav aria-label="主导航">
			{links.map(({ href, label }) => <a href={href} aria-current={pathname === href || (href !== '/' && pathname.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
		</nav>
		<button class="theme-toggle" type="button" aria-label="切换深浅色模式" title="切换深浅色模式"><span aria-hidden="true">◐</span></button>
	</div>
</header>

<script>
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
	button?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
	});
</script>
