---
import { SITE_TITLE } from '../consts';
import { alternateUrl, localePath, type Locale } from '../i18n';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const pathname = Astro.url.pathname;
const switchTo = lang === 'zh' ? 'en' : 'zh';
const links = [
	{ href: '/', label: lang === 'en' ? 'Home' : '首页' },
	{ href: '/blog/', label: lang === 'en' ? 'Writing' : '文章' },
	{ href: '/about/', label: lang === 'en' ? 'About' : '关于' },
	{ href: '/friends/', label: lang === 'en' ? 'Links' : '友链' },
];
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href={localePath('/', lang)} aria-label={lang === 'en' ? 'Pangpang Blog home' : `${SITE_TITLE}首页`}>
			<img class="brand-photo" src="/images/bear-logo.png" alt="" width="40" height="40" />
			<span>{SITE_TITLE}</span>
		</a>
		<nav aria-label={lang === 'en' ? 'Main navigation' : '主导航'}>
			{links.map(({ href, label }) => {
				const localizedHref = localePath(href, lang);
				return <a href={localizedHref} aria-current={pathname === localizedHref || (href !== '/' && pathname.startsWith(localizedHref)) ? 'page' : undefined}>{label}</a>;
			})}
		</nav>
		<div class="header-controls">
			<a class="language-toggle" href={alternateUrl(Astro.url, switchTo)} aria-label={lang === 'en' ? '切换到中文' : 'Switch to English'} title={lang === 'en' ? '切换到中文' : 'Switch to English'}>
				<span class={lang === 'zh' ? 'active' : undefined}>中</span><span aria-hidden="true">/</span><span class={lang === 'en' ? 'active' : undefined}>EN</span>
			</a>
			<button class="theme-toggle" type="button" aria-label={lang === 'en' ? 'Toggle reading mode' : '切换阅读模式'} title={lang === 'en' ? 'Toggle reading mode' : '切换阅读模式'} aria-pressed="false"><span aria-hidden="true">◐</span></button>
		</div>
	</div>
</header>

<script>
	import { alternateUrl } from '../i18n';
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const languageLink = document.querySelector<HTMLAnchorElement>('.language-toggle');
	const locale = document.documentElement.lang.startsWith('en') ? 'en' : 'zh';
	const otherLocale = locale === 'en' ? 'zh' : 'en';
	function updateLanguageLink() {
		if (languageLink) languageLink.href = alternateUrl(new URL(location.href), otherLocale);
	}
	updateLanguageLink();
	window.addEventListener('popstate', updateLanguageLink);
	window.addEventListener('blog:location-changed', updateLanguageLink);
	function updateButton() {
		if (!button) return;
		const dark = document.documentElement.dataset.theme === 'dark';
		button.setAttribute('aria-pressed', String(dark));
		button.setAttribute('aria-label', locale === 'en' ? (dark ? 'Switch to light reading mode' : 'Switch to dark reading mode') : (dark ? '切换到浅色阅读模式' : '切换到深色阅读模式'));
		button.title = button.getAttribute('aria-label') || '';
		const icon = button.querySelector('span');
		if (icon) icon.textContent = dark ? '☀' : '☾';
	}
	updateButton();
	button?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
		updateButton();
	});
</script>
