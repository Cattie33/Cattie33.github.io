---
import SiteLayout from '../layouts/SiteLayout.astro';
import { localePath, type Locale } from '../i18n';
import { getLocalizedPosts } from '../posts';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const posts = (await getLocalizedPosts(lang)).slice(0, 3);
---

<SiteLayout lang={lang}>
	<main>
		<section class="home-intro">
			<h1>{lang === 'en' ? 'Hello, come on in.' : '你好，欢迎来坐坐。'}</h1>
			<p>{lang === 'en' ? 'This is Mi: stories and words about me.' : '这里是咪，关于me的故事和文字。'}</p>
			<a class="intro-link" href={localePath('/blog/', lang)}>{lang === 'en' ? 'Read the blog' : '读读文章'} <span aria-hidden="true">↗</span></a>
		</section>

		<figure class="home-photo">
			<img src="/images/flower-bear.jpeg" alt={lang === 'en' ? 'A small bear in a straw hat sitting among blue and purple flowers' : '戴着草帽的小熊坐在蓝紫色花丛中'} width="4034" height="3024" fetchpriority="high" />
		</figure>

		<section class="home-latest" aria-labelledby="latest-heading">
			<div class="latest-heading">
				<h2 id="latest-heading">{lang === 'en' ? 'Recent writing' : '最近写的'}</h2>
				<a href={localePath('/blog/', lang)}>{lang === 'en' ? 'All posts' : '全部文章'} <span aria-hidden="true">→</span></a>
			</div>
			<ul>
				{posts.map((post) => (
					<li>
						<a href={localePath(`/blog/${post.id}/`, lang)}>{post.data.title}</a>
						<time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Shanghai' })}</time>
					</li>
				))}
			</ul>
		</section>
	</main>
</SiteLayout>

<style>
	.home-intro {
		width: min(760px, calc(100% - 48px));
		margin: 0 auto;
		padding: clamp(4.5rem, 7vw, 6.25rem) 0 3.5rem;
		text-align: center;
	}

	.home-intro h1 {
		margin: 0;
		font-family: Georgia, 'Songti SC', serif;
		font-size: clamp(2.7rem, 6vw, 4.5rem);
		font-weight: 600;
		letter-spacing: -.045em;
		line-height: 1.3;
	}

	.home-intro p {
		margin: 1.2rem auto 0;
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.9;
	}

	.intro-link {
		display: inline-flex;
		gap: .35rem;
		margin-top: 1.5rem;
		color: var(--accent);
		font-size: .95rem;
		font-weight: 600;
		text-decoration: none;
	}

	.intro-link:hover,
	.latest-heading a:hover,
	.home-latest li a:hover { text-decoration: underline; }

	.home-photo {
		width: min(900px, calc(100% - 48px));
		margin: 0 auto;
	}

	.home-photo img {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		object-position: center 48%;
		border-radius: 12px;
	}

	.home-latest {
		width: min(760px, calc(100% - 48px));
		margin: 5.5rem auto 0;
	}

	.latest-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.latest-heading h2 {
		margin: 0;
		font-family: Georgia, 'Songti SC', serif;
		font-size: 1.65rem;
		font-weight: 600;
	}

	.latest-heading a {
		color: var(--accent);
		font-size: .87rem;
		text-decoration: none;
		white-space: nowrap;
	}

	.home-latest ul {
		list-style: none;
		margin: 1.1rem 0 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.home-latest li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.05rem 0;
		border-bottom: 1px solid var(--line);
	}

	.home-latest li a {
		font-family: Georgia, 'Songti SC', serif;
		font-size: 1.05rem;
		text-decoration: none;
	}

	.home-latest time {
		flex: none;
		color: var(--muted);
		font-size: .8rem;
	}

	@media (max-width: 560px) {
		.home-intro, .home-photo, .home-latest { width: calc(100% - 32px); }
		.home-intro { padding: 4.6rem 0 2.7rem; }
		.home-intro h1 { font-size: 2.7rem; }
		.home-intro p { font-size: .96rem; }
		.home-photo img { aspect-ratio: 4 / 3; }
		.home-latest { margin-top: 4rem; }
		.home-latest li { align-items: start; flex-direction: column; gap: .2rem; }
	}
</style>
