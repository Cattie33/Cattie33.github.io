---
import SiteLayout from '../layouts/SiteLayout.astro';
import { localePath, type Locale } from '../i18n';
import { getLocalizedPosts } from '../posts';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const posts = (await getLocalizedPosts(lang)).slice(0, 3);
---

<SiteLayout lang={lang}>
	<main>
		<section class="home-hero">
			<div class="home-scene" aria-hidden="true">
				<img src="/images/mi-autumn-bear-background.jpg" alt="" width="1024" height="772" fetchpriority="high" />
				<video autoplay muted loop playsinline preload="auto" poster="/images/mi-autumn-bear-background.jpg">
					<source src="/videos/mi-autumn-bear-background.mp4" type="video/mp4" />
				</video>
			</div>
			<div class="home-intro">
				<h1>{lang === 'en' ? 'Hello, come on in.' : '你好，欢迎来坐坐。'}</h1>
				<p>{lang === 'en' ? 'This is Mi: stories and words about me.' : '这里是咪，关于me的故事和文字。'}</p>
				<a class="intro-link" href={localePath('/blog/', lang)}>{lang === 'en' ? 'Read the blog' : '读读文章'} <span aria-hidden="true">↗</span></a>
			</div>
		</section>

		<section class="home-latest" aria-labelledby="latest-heading">
			<div class="latest-heading">
				<h2 id="latest-heading">{lang === 'en' ? 'Recent writing' : '最近写的'}</h2>
				<a href={localePath('/blog/', lang)}>{lang === 'en' ? 'All posts' : '全部文章'} <span aria-hidden="true">→</span></a>
			</div>
			<ul>
				{posts.map((post) => (
					<li>
						<a href={localePath(`/blog/${post.id}/`, lang)}>{post.data.title}</a>
						<time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Shanghai' })}</time>
					</li>
				))}
			</ul>
		</section>
	</main>
</SiteLayout>

<script>
	const sceneVideo = document.querySelector<HTMLVideoElement>('.home-scene video');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	function syncMotionPreference() {
		if (!sceneVideo) return;
		if (reducedMotion.matches) sceneVideo.pause();
		else sceneVideo.play().catch(() => { /* The poster remains visible. */ });
	}
	syncMotionPreference();
	reducedMotion.addEventListener('change', syncMotionPreference);
</script>

<style>
	.home-hero {
		position: relative;
		isolation: isolate;
		height: calc(100svh - 84px);
		min-height: 500px;
		overflow: hidden;
		background: #f7f0df;
	}

	.home-hero::after {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 0;
		background: linear-gradient(to bottom, rgba(247, 244, 238, .56), rgba(247, 244, 238, 0) 52%);
		pointer-events: none;
	}

	.home-scene {
		position: absolute;
		z-index: -2;
		inset: 0;
		pointer-events: none;
	}

	.home-scene img,
	.home-scene video {
		display: block;
		position: absolute;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 74%;
	}

	:global(:root[data-theme='dark']) .home-hero { background: #182231; }
	:global(:root[data-theme='dark']) .home-scene { filter: brightness(.48) saturate(.84); }
	:global(:root[data-theme='dark']) .home-hero::after { background: linear-gradient(to bottom, rgba(24, 34, 49, .78), rgba(24, 34, 49, 0) 60%); }

	.home-intro {
		position: relative;
		z-index: 1;
		width: min(760px, calc(100% - 48px));
		margin: 0 auto;
		padding: clamp(4rem, 9vh, 6rem) 0 0;
		text-align: center;
	}

	.home-intro h1 {
		margin: 0;
		font-family: Georgia, 'Songti SC', serif;
		font-size: clamp(2.7rem, 6vw, 4.5rem);
		font-weight: 600;
		letter-spacing: -.045em;
		line-height: 1.3;
	}

	.home-intro p {
		margin: 1.2rem auto 0;
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.9;
	}

	.intro-link {
		display: inline-flex;
		gap: .35rem;
		margin-top: 1.5rem;
		color: var(--accent);
		font-size: .95rem;
		font-weight: 600;
		text-decoration: none;
	}

	.intro-link:hover,
	.latest-heading a:hover,
	.home-latest li a:hover { text-decoration: underline; }

	.home-latest {
		width: min(760px, calc(100% - 48px));
		margin: 4rem auto 0;
	}

	.latest-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.latest-heading h2 {
		margin: 0;
		font-family: Georgia, 'Songti SC', serif;
		font-size: 1.65rem;
		font-weight: 600;
	}

	.latest-heading a {
		color: var(--accent);
		font-size: .87rem;
		text-decoration: none;
		white-space: nowrap;
	}

	.home-latest ul {
		list-style: none;
		margin: 1.1rem 0 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.home-latest li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.05rem 0;
		border-bottom: 1px solid var(--line);
	}

	.home-latest li a {
		font-family: Georgia, 'Songti SC', serif;
		font-size: 1.05rem;
		text-decoration: none;
	}

	.home-latest time {
		flex: none;
		color: var(--muted);
		font-size: .8rem;
	}

	@media (max-width: 560px) {
		.home-intro, .home-latest { width: calc(100% - 32px); }
		.home-hero { height: calc(100svh - 98px); min-height: 540px; }
		.home-scene img, .home-scene video { object-position: 90% center; }
		.home-intro { padding-top: 4.3rem; }
		.home-intro h1 { font-size: clamp(1.85rem, 8vw, 2.25rem); }
		.home-intro p { font-size: .96rem; }
		.home-latest li { align-items: start; flex-direction: column; gap: .2rem; }
	}

	@media (min-width: 561px) and (max-width: 900px) {
		.home-scene img, .home-scene video { object-position: 75% 74%; }
	}

	@media (prefers-reduced-motion: reduce) {
		.home-scene video { display: none; }
	}
</style>
