---
import SiteLayout from '../layouts/SiteLayout.astro';
import { localePath, type Locale } from '../i18n';
import { getLocalizedPosts } from '../posts';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const posts = await getLocalizedPosts(lang);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b, lang === 'en' ? 'en' : 'zh-CN'));
const english = lang === 'en';
const archivePath = localePath('/blog/', lang);
const formatDate = (date: Date) => date.toLocaleDateString(english ? 'en-US' : 'zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Shanghai' });
---

<SiteLayout lang={lang} title={english ? 'All posts' : '全部文章'} description={english ? 'Browse all posts on Pangpang Blog by keyword or topic.' : '浏览胖胖博客的全部文章，按关键词和标签查找。'}>
	<main class="container archive-page" data-locale={lang}>
		<div class="page-heading">
			<span class="eyebrow">Archive</span>
			<h1>{english ? 'All posts' : '全部文章'}</h1>
			<p>{english ? 'All the writing is here. Search by title, summary, or tag, or browse by topic.' : '写过的文字都在这里。可以搜索标题、摘要和标签，也可以按话题浏览。'}</p>
		</div>
		<div class="archive-layout">
			<aside class="archive-sidebar" aria-label={english ? 'Post tags' : '文章标签'}>
				<h2>{english ? 'Browse topics' : '浏览话题'}</h2>
				<div class="filter-tags">
					<button class="filter-tag" type="button" data-tag="" aria-pressed="true">{english ? 'All' : '全部'}</button>
					{tags.map((tag) => <button class="filter-tag" type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}
				</div>
			</aside>
			<section aria-label={english ? 'Post list' : '文章列表'}>
				<div class="archive-tools">
					<label><span class="sr-only">{english ? 'Search posts' : '搜索文章'}</span><input id="post-search" type="search" placeholder={english ? 'Search titles, summaries, or tags…' : '搜索标题、摘要或标签…'} autocomplete="off" /></label>
					<label><span class="sr-only">{english ? 'Sort posts' : '排序文章'}</span><select id="post-sort"><option value="newest">{english ? 'Newest first' : '最新发布'}</option><option value="oldest">{english ? 'Oldest first' : '最早发布'}</option><option value="title">{english ? 'By title' : '标题排序'}</option></select></label>
				</div>
				<p class="result-count" aria-live="polite">{english ? `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}` : `共 ${posts.length} 篇文章`}</p>
				<div class="post-list" id="post-list">
					{posts.map((post) => <article class="post-row" data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLocaleLowerCase()} data-tags={post.data.tags.join('|')} data-date={post.data.pubDate.toISOString()} data-title={post.data.title}>
						<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
						<h2><a href={localePath(`/blog/${post.id}/`, lang)}>{post.data.title}</a></h2>
						<p>{post.data.description}</p>
						<div class="tag-list">{post.data.tags.map((tag) => <a class="tag" href={`${archivePath}?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
					</article>)}
				</div>
				<p class="empty-results" hidden>{english ? 'No matching posts. Try another keyword or topic.' : '没有找到匹配的文章。试试别的关键词或标签。'}</p>
			</section>
		</div>
	</main>
	<script>
		const main = document.querySelector<HTMLElement>('.archive-page');
		const english = main?.dataset.locale === 'en';
		const search = document.querySelector<HTMLInputElement>('#post-search');
		const sort = document.querySelector<HTMLSelectElement>('#post-sort');
		const list = document.querySelector<HTMLElement>('#post-list');
		const rows = Array.from(document.querySelectorAll<HTMLElement>('.post-row'));
		const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-tag'));
		let selectedTag = new URLSearchParams(location.search).get('tag') || '';
		function update() {
			const query = (search?.value || '').trim().toLocaleLowerCase();
			let visible = 0;
			for (const row of rows) {
				const matches = (!selectedTag || (row.dataset.tags || '').split('|').includes(selectedTag)) && (!query || (row.dataset.search || '').includes(query));
				row.hidden = !matches;
				if (matches) visible++;
			}
			const order = sort?.value || 'newest';
			rows.sort((a, b) => order === 'title' ? (a.dataset.title || '').localeCompare(b.dataset.title || '', english ? 'en' : 'zh-CN') : order === 'oldest' ? (a.dataset.date || '').localeCompare(b.dataset.date || '') : (b.dataset.date || '').localeCompare(a.dataset.date || ''));
			rows.forEach((row) => list?.append(row));
			buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.tag === selectedTag)));
			const count = document.querySelector<HTMLElement>('.result-count');
			if (count) count.textContent = english ? `${visible} ${visible === 1 ? 'post' : 'posts'}` : `找到 ${visible} 篇文章`;
			const empty = document.querySelector<HTMLElement>('.empty-results');
			if (empty) empty.hidden = visible > 0;
		}
		buttons.forEach((button) => button.addEventListener('click', () => {
			selectedTag = button.dataset.tag || '';
			const url = new URL(location.href);
			if (selectedTag) url.searchParams.set('tag', selectedTag); else url.searchParams.delete('tag');
			history.replaceState(null, '', url);
			window.dispatchEvent(new Event('blog:location-changed'));
			update();
		}));
		search?.addEventListener('input', update);
		sort?.addEventListener('change', update);
		update();
	</script>
</SiteLayout>
