---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import { alternateUrl, type Locale } from '../i18n';

interface Props { title: string; description: string; lang: Locale; }
const { title, description, lang } = Astro.props;
const siteTitle = SITE_TITLE;
const pageTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const chineseURL = new URL(alternateUrl(Astro.url, 'zh'), Astro.site);
const englishURL = new URL(alternateUrl(Astro.url, 'en'), Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#f7f4ee" />
<link rel="icon" type="image/png" href="/images/bear-logo.png" />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="zh-CN" href={chineseURL} />
<link rel="alternate" hreflang="en" href={englishURL} />
<link rel="alternate" hreflang="x-default" href={chineseURL} />
<link rel="alternate" type="application/rss+xml" title={siteTitle} href={new URL(lang === 'en' ? '/en/rss.xml' : '/rss.xml', Astro.site)} />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<title>{pageTitle}</title>
<script is:inline>
	try { document.documentElement.dataset.theme = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch { /* Keep the default theme. */ }
</script>
